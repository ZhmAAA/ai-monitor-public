{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Monitor",
  "version": "0.1.0",
  "identifier": "local.ai-monitor.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Monitor",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 620,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/ai-monitor-daemon.exe"]
  }
}
