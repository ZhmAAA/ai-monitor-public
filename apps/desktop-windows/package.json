{
  "name": "ai-monitor-desktop-windows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "daemon:build": "cargo build -p ai-monitor-daemon --manifest-path ../../Cargo.toml",
    "tauri:dev": "npm run daemon:build && tauri dev",
    "tauri:app": "npm run daemon:build && node scripts/copy-daemon.mjs && tauri build --no-bundle",
    "tauri:build": "npm run daemon:build && node scripts/copy-daemon.mjs && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
